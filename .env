# === CORE ===
PORT=5003
NODE_ENV=production

# === DATABASE & CACHE ===
DATABASE_URL=postgres://postgres:password@localhost:5432/chefs_mind_ai
DATABASE_READONLY_URL=postgres://postgres:password@localhost:5432/chefs_mind_ai_ro
REDIS_URL=redis://localhost:6379/0

# === SECURITY & AUTH ===
SAFE_MODE=on
CONFIRM_CODE=prod-test-2025
SESSION_SECRET=super-secret-session-key-for-production-testing-2025
COOKIE_DOMAIN=localhost

# === GOOGLE OAUTH & SERVICES ===
GOOGLE_CLIENT_ID=test-google-client-id-placeholder
GOOGLE_CLIENT_SECRET=test-google-client-secret-placeholder
GOOGLE_REDIRECT_URI=http://localhost:5003/auth/google/callback
GOOGLE_SCOPES=email profile https://www.googleapis.com/auth/calendar https://www.googleapis.com/auth/drive https://www.googleapis.com/auth/spreadsheets
GOOGLE_API_KEY=
GOOGLE_OAUTH_CLIENT_ID=test-google-client-id-placeholder
GOOGLE_OAUTH_CLIENT_SECRET=test-google-client-secret-placeholder
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5003/auth/google/callback

# === MEDIA PROVIDERS ===
OPENAI_API_KEY=
MEDIA_PROVIDER_DEFAULT=dall-e-3
ALLOW_MEDIA_FALLBACK=true

# === CORS & RATE LIMIT ===
CORS_ORIGIN=http://localhost:5003,http://localhost:3000
RATE_LIMIT=1000

# === SMOKE & DEBUG FLAGS ===
RBAC_SMOKE_ADMIN=0
GOOGLE_AUTH_SMOKE_BYPASS=0