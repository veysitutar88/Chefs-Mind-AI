# Chef's Mind AI - Environment Configuration

# Server Configuration
PORT=5001
BASE_URL=http://localhost:5001
ENABLE_VIDEO=false
CORS_ORIGIN=http://localhost:3001,http://localhost:3000

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:5001

# Database (using SQLite for development)
DATABASE_URL=file:./dev.db

# Authentication (development only)
SESSION_SECRET=dev-session-secret
GOOGLE_CLIENT_ID=dummy
GOOGLE_CLIENT_SECRET=dummy
GOOGLE_REDIRECT_URI=http://localhost:5001/auth/google/callback

# AI Providers (development only)
# REQUIRED for LLM calls: replace 'dummy' with real keys before running npm run dev:back
# Real keys are stored in .env.local — copy them here for the dev server to load at startup.
OPENAI_API_KEY=dummy
GOOGLE_API_KEY=dummy          # used by graph.ts → accountantNode (Gemini); .env.local has this as GOOGLE_KEY
PERPLEXITY_API_KEY=dummy
GOOGLE_VERTEX_PROJECT_ID=dummy
GOOGLE_VERTEX_LOCATION=us-central1

# Media Services
OPENAI_API_KEY=dummy

# Development
NODE_ENV=development
CONFIRM_CODE=dev-confirm-code-1234567890abcdef1234567890
SESSION_SECRET=dev-session-secret-1234567890abcdef1234567890
