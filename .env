# === CORE ===
PORT=5003
NODE_ENV=development

# === CORS ===
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:5003

# === RATE LIMIT ===
RATE_LIMIT=1000

# === PROMETHEUS & METRICS ===
PROMETHEUS_PORT=9090
METRICS_ENABLED=true

# === DATABASE & CACHE ===
# Временные значения для разработки
DATABASE_URL=postgresql://postgres:password@localhost:5432/chefs_mind_dev
DATABASE_READONLY_URL=postgresql://postgres:password@localhost:5432/chefs_mind_dev
REDIS_URL=redis://localhost:6379/0

# === SECURITY & AUTH ===
SAFE_MODE=on
CONFIRM_CODE=dev-confirm-2025
SESSION_SECRET=dev-session-secret-key-for-development-only
COOKIE_DOMAIN=localhost

# === GOOGLE OAUTH & SERVICES ===
# Заглушки для разработки
GOOGLE_CLIENT_ID=dev-google-client-id
GOOGLE_CLIENT_SECRET=dev-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5003/auth/google/callback
GOOGLE_SCOPES=email profile https://www.googleapis.com/auth/calendar https://www.googleapis.com/auth/drive https://www.googleapis.com/auth/spreadsheets
GOOGLE_API_KEY=
# Альтернативные имена переменных для совместимости
GOOGLE_OAUTH_CLIENT_ID=dev-google-client-id
GOOGLE_OAUTH_CLIENT_SECRET=dev-google-client-secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5003/auth/google/callback

# === MEDIA PROVIDERS ===
# Заглушки для разработки
OPENAI_API_KEY=dev-openai-key
VERTEX_PROJECT_ID=dev-gcp-project
VERTEX_LOCATION=us-central1
MEDIA_PROVIDER_DEFAULT=dall-e-3
MEDIA_VIDEO_PROVIDER_DEFAULT=veo-3
ALLOW_MEDIA_FALLBACK=true

# === SMOKE & DEBUG FLAGS ===
RBAC_SMOKE_ADMIN=0
GOOGLE_AUTH_SMOKE_BYPASS=0