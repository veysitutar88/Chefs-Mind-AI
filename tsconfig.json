{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "noEmit": false,
    "sourceMap": false,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": false,
    "isolatedModules": false,
    "baseUrl": ".",
    "paths": {
      "@shared/schema": ["shared/schema.ts"],
      "@shared/schema.js": ["shared/schema.ts"],
      "@shared/*": ["shared/*"]
    },
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "incremental": true,
    "tsBuildInfoFile": ".tsbuildinfo"
  },
  "include": ["server/**/*", "shared/**/*"],
  "exclude": ["node_modules", "dist", "frontend", "frontend-enhanced", "frontend-simple"]
}