# ─────────────────────────────────────────────────────────────────────────────
# Production Environment Template
# Copy to .env.prod and fill in real values before running docker compose -f docker-compose.prod.yml up -d
# .env.prod is in .gitignore — NEVER commit it.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=5001
ENABLE_VIDEO=false

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGIN=https://your-domain.com
NEXT_PUBLIC_API_URL=https://your-domain.com

# ── Rate limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT=100

# ── Session ───────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 64
SESSION_SECRET=CHANGE_ME_generate_with_openssl_rand_-hex_64
SESSION_COOKIE_SECURE=true
COOKIE_DOMAIN=your-domain.com

# ── Safe Mode ─────────────────────────────────────────────────────────────────
SAFE_MODE=on
CONFIRM_CODE=CHANGE_ME

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=chefs
POSTGRES_PASSWORD=CHANGE_ME_strong_password_here
POSTGRES_DB=chefsmind
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}

# ── Redis ─────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
REDIS_PASSWORD=CHANGE_ME_generate_with_openssl_rand_-hex_32
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379

# ── Google OAuth ──────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_OAUTH_REDIRECT_URI=https://your-domain.com/auth/google/callback
GOOGLE_API_KEY=your-google-api-key
GOOGLE_OAUTH_SCOPES=openid email profile https://www.googleapis.com/auth/spreadsheets

# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── Media ─────────────────────────────────────────────────────────────────────
MEDIA_PROVIDER_DEFAULT=openai
ALLOW_MEDIA_FALLBACK=true
