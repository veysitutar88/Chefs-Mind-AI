# Production конфигурация для G1 Google OAuth интеграции
NODE_ENV=production
PORT=5001

# Безопасность
SESSION_SECRET=chefsmind-production-secret-2024
COOKIE_DOMAIN=localhost

# Safe Mode (production должен быть включён)
SAFE_MODE=on
CONFIRM_CODE=PROD-CONFIRM-2024

# Google OAuth Production переменные
GOOGLE_CLIENT_ID=your-production-client-id.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-production-client-secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5001/auth/google/callback
GOOGLE_OAUTH_SCOPES=https://www.googleapis.com/auth/spreadsheets,https://www.googleapis.com/auth/calendar,https://www.googleapis.com/auth/contacts,https://www.googleapis.com/auth/drive

# Production database (PostgreSQL)
DATABASE_URL=postgresql://postgres:password@localhost:5432/chefsmind_prod
DATABASE_READONLY_URL=postgresql://postgres:password@localhost:5432/chefsmind_prod

# Rate limiting (production)
RATE_LIMIT=1000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:5001