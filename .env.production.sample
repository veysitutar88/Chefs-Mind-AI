# Файл: .env.production.sample (НОВЫЙ ФАЙЛ)

# === PRODUCTION ENVIRONMENT VARIABLES ===
# Скопируйте эти переменные в .env.production для продакшн среды

# === CORE PRODUCTION ===
# Используйте продакшн значения вместо dev-значений
NODE_ENV=production
# PORT=5003 - раскомментируйте и установите правильный продакшн порт
# PORT=80
# PORT=443

# === PRODUCTION DATABASE & CACHE ===
# PRODUCTION_DATABASE_URL=postgres://user:pass@prod-host:5432/prod_db
# PRODUCTION_DATABASE_READONLY_URL=postgres://user:pass@prod-host:5432/prod_db_ro
# PRODUCTION_REDIS_URL=redis://user:pass@prod-host:6379/0

# === PRODUCTION SECURITY & AUTH ===
# Используйте строгие продакшн значения
# PRODUCTION_SESSION_SECRET=super-secure-production-secret-key-256bit
# PRODUCTION_COOKIE_DOMAIN=your-domain.com

# === PRODUCTION API BASE ===
# Для продакшн фронтенда используйте:
# NEXT_PUBLIC_API_BASE=https://your-domain.com

# === PRODUCTION GOOGLE OAUTH ===
# ВАЖНО: Обновите Google OAuth redirect URI для продакшн домена
# GOOGLE_REDIRECT_URI=https://your-domain.com/auth/google/callback
# GOOGLE_OAUTH_REDIRECT_URI=https://your-domain.com/auth/google/callback

# === PRODUCTION MEDIA PROVIDERS ===
# PRODUCTION_OPENAI_API_KEY=sk-prod-your-openai-key
# PRODUCTION_MEDIA_PROVIDER_DEFAULT=dall-e-3

# === CORS ORIGIN (PRODUCTION) ===
# Установите ваш продакшн домен
# CORS_ORIGIN=https://your-domain.com

# === NOTES ===
# 1. Все продакшн переменные должны начинаться с PRODUCTION_ или быть явно переименованы
# 2. Используйте сильные секретные ключи в продакшн
# 3. Обновите Google OAuth настройки для продакшн домена
# 4. PORT может быть 80/443 для HTTP/HTTPS или другой по требованию
# 5. NEXT_PUBLIC_API_BASE должен указывать на ваш продакшн API домен
# 6. Сохраните этот файл как .env.production в корне проекта для использования