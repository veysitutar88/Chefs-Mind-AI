9) Universal Ask — стабилизация (ближайшие задачи)
Цели
Таймаут 12s для Chef: обёртка callLLM() в withTimeout(12000); вне models.ts.
Fallback chain: цепочка моделей по скорости; остановка на первом успехе.
Route field: data.route.model = finalModelId в ответе.
Streams временно OFF: флаг STREAM_OFF=true для упрощённого JSON; после стабилизации вернуть SSE.
Псевдокод (вставка в server/routes/universal.ts или аналог)
typescript
async function withTimeout<T>(p: Promise<T>, ms: number): Promise<T> {
  let t: NodeJS.Timeout;
  const timeout = new Promise<never>((_, rej) =>
    t = setTimeout(() => rej(new Error("Timeout")), ms)
  );
  try { return await Promise.race([p, timeout]); }
  finally { clearTimeout(t); }
}

async function callWithFallbacks(run: (modelId: string) => Promise<any>, models: string[], timeoutMs?: number) {
  let lastErr;
  for (const m of models) {
    try {
      const p = run(m);
      const res = timeoutMs ? await withTimeout(p, timeoutMs) : await p;
      return { ok: true, model: m, data: res };
    } catch (e) { lastErr = e; }
  }
  return { ok: false, error: String(lastErr ?? "Unknown error") };
}

export async function universalAsk(params: { role: string; query: string; systemPrompt?: string; timeoutMs?: number }) {
  const isChef = params.role?.toLowerCase() === "chef";
  const route = pickModelsFor(params);          // вернёт массив моделей по скорости (gpt-4o-mini → gpt-4o → gemini-2.0-flash-exp)
  const timeout = isChef ? 12_000 : (params.timeoutMs ?? 30_000);

  const result = await callWithFallbacks(
    (modelId) => callLLM({ ...params, modelId }),
    route.models,
    timeout
  );

  if (!result.ok) return { success: false, error: result.error, route: { model: null } };
  return { success: true, data: result.data, route: { model: result.model } };
}



