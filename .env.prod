# === CORE ===
PORT=5001
NODE_ENV=production

# === DATABASE & CACHE ===
DATABASE_URL=postgres://chefs:chefs@db:5432/chefsmind
DATABASE_READONLY_URL=postgres://chefs:chefs@db:5432/chefsmind
REDIS_URL=redis://redis:6379/0

# === SECURITY & AUTH ===
SAFE_MODE=on
CONFIRM_CODE=chefsmind-prod-2025
SESSION_SECRET=chefsmind-production-secret-key-for-sessions-2025-ultra-secure
COOKIE_DOMAIN=chefsmind.ai
CORS_ORIGIN=https://chefsmind.ai,https://app.chefsmind.ai,https://www.chefsmind.ai

# === RATE LIMIT ===
RATE_LIMIT=1000

# === GOOGLE OAUTH & SERVICES ===
# Google OAuth — Production домен
GOOGLE_CLIENT_ID=your-google-client-id-prod
GOOGLE_CLIENT_SECRET=your-google-client-secret-prod
GOOGLE_REDIRECT_URI=https://chefsmind.ai/auth/google/callback
GOOGLE_SCOPES=email profile https://www.googleapis.com/auth/calendar https://www.googleapis.com/auth/drive https://www.googleapis.com/auth/spreadsheets
GOOGLE_API_KEY=your-google-api-key-prod
# Google OAuth — альтернативные имена переменных (для совместимости)
GOOGLE_OAUTH_CLIENT_ID=your-google-client-id-prod
GOOGLE_OAUTH_CLIENT_SECRET=your-google-client-secret-prod
GOOGLE_OAUTH_REDIRECT_URI=https://chefsmind.ai/auth/google/callback

# === MEDIA PROVIDERS ===
OPENAI_API_KEY=your-openai-api-key-prod
MEDIA_PROVIDER_DEFAULT=dall-e-3
ALLOW_MEDIA_FALLBACK=true

# === FRONTEND ===
NEXT_PUBLIC_API_URL=https://chefsmind.ai

# === SMOKE & DEBUG FLAGS ===
RBAC_SMOKE_ADMIN=0
GOOGLE_AUTH_SMOKE_BYPASS=0

# === PROMETHEUS & METRICS ===
PROMETHEUS_PORT=9090
METRICS_ENABLED=true