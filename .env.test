# Тестовые переменные окружения для G1 интеграции
NODE_ENV=development
PORT=5001

# База данных (используем SQLite для локального тестирования)
DATABASE_URL=file:./test.db
DATABASE_READONLY_URL=file:./test.db

# Безопасность
SESSION_SECRET=test-secret-key-for-dev
COOKIE_DOMAIN=localhost

# Safe Mode (включён для безопасности)
SAFE_MODE=on
CONFIRM_CODE=CONFIRM123

# OpenAI (необязательно для базового тестирования)
OPENAI_API_KEY=demo-key

# Google OAuth (для тестирования - использовать тестовые значения)
GOOGLE_CLIENT_ID=test-client-id
GOOGLE_CLIENT_SECRET=test-client-secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5001/auth/google/callback
GOOGLE_OAUTH_SCOPES=https://www.googleapis.com/auth/spreadsheets,https://www.googleapis.com/auth/calendar

# Rate limiting
RATE_LIMIT=100

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:5001