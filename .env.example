# добавить на главную страницу (если есть /frontend-enhanced/app/page.tsx)
node - <<-JS
const fs=require('fs'), p='frontend-enhanced/app/page.tsx';
if(fs.existsSync(p)){
  let s=fs.readFileSync(p,'utf8');
  if(!/GoogleConnect/.test(s)){
    s = s.replace(/from \"..\/components\/MediaForm\";?/, (m)=>m||"");
    if(!/import GoogleConnect/.test(s)) s = 'import GoogleConnect from "../components/GoogleConnect";\n' + s;
    s = s.replace(/<\/main>\s*;\s*}\s*$/, '<GoogleConnect />\n    </main>\n);\n}\n');
    fs.writeFileSync(p,s);
  }
}
JS

# ===== 7) TS-проверка + подсказки =====
npx tsc -p . --noEmit | tee logs/oauth-ts.txt || true

echo "[OK] OAuth routes mounted:"
echo " - GET  /auth/google/start      → редирект на Google"
echo " - GET  /auth/google/callback   → приём токенов"
echo " - GET  /auth/google/status     → статус"
echo " - POST /auth/google/logout     → сброс"
echo " - GET  /auth/google/calendars  → список календарей (после авторизации)"
echo " - POST /auth/google/docs       → создать документ"
echo " - POST /auth/google/sheets     → создать таблицу"

echo "Что сделать тебе"
echo ""
echo "В .env вписать:"
echo ""
echo "SESSION_SECRET — любой длинный случайный текст"
echo ""
echo "GOOGLE_CLIENT_ID и GOOGLE_CLIENT_SECRET (из Google Cloud Console → OAuth 2.0 Client ID)"
echo ""
echo "GOOGLE_REDIRECT_URI — точно http://localhost:5002/auth/google/callback (и добавь этот URI в настройках OAuth)"
echo ""
echo "Перезапустить бэкенд."
echo ""
echo "Быстрые проверки"
echo "# 1) открыть в браузере:"
echo "http://localhost:5002/auth/google/start"
echo ""
echo "# 2) статус:"
echo "curl -s http://localhost:5002/auth/google/status | jq ."
echo ""
echo "# 3) после успешной авторизации:"
echo "curl -s http://localhost:5002/auth/google/calendars | jq ."
echo "curl -s -X POST http://localhost:5002/auth/google/docs -H 'content-type: application/json' -d '{\"title\":\"Chef Mind — Test Doc\"}' | jq ."
echo "curl -s -X POST http://localhost:5002/auth/google/sheets -H 'content-type: application/json' -d '{\"title\":\"Chef Mind — Test Sheet\"}' | jq ."
echo ""
echo ""
echo "Готово. Скажешь «идём дальше» — подготовлю Variant S (Sora v2 + Prompt Profiles финализация и смоки по всем провайдерам)."
# --- Google OAuth ---
SESSION_SECRET=change_me_please
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5002/auth/google/callback
# Разрешения: календарь, документы, таблицы (read/write)
GOOGLE_SCOPES=https://www.googleapis.com/auth/calendar https://www.googleapis.com/auth/documents https://www.googleapis.com/auth/drive.file https://www.googleapis.com/auth/spreadsheets
