# === CORE ===
PORT=5003
NODE_ENV=development

# === DATABASE & CACHE ===
DATABASE_URL=postgres://user:pass@host:5432/db
DATABASE_READONLY_URL=postgres://user:pass@host:5432/db_ro
REDIS_URL=redis://user:pass@host:6379/0

# === SECURITY & AUTH ===
SAFE_MODE=on
CONFIRM_CODE=change-me
SESSION_SECRET=your-strong-secret-key-for-sessions
COOKIE_DOMAIN=localhost

# === GOOGLE OAUTH & SERVICES ===
# Google OAuth — заполните из Google Cloud Console
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Для DEV должен совпадать с настройкой в Google Console
GOOGLE_REDIRECT_URI=http://localhost:5003/auth/google/callback
GOOGLE_SCOPES=email profile https://www.googleapis.com/auth/calendar https://www.googleapis.com/auth/drive https://www.googleapis.com/auth/spreadsheets
GOOGLE_API_KEY=
# Google OAuth — альтернативные имена переменных (для совместимости)
GOOGLE_OAUTH_CLIENT_ID=your-google-client-id
GOOGLE_OAUTH_CLIENT_SECRET=your-google-client-secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5003/auth/google/callback

# === MEDIA PROVIDERS ===
# OpenAI API ключ для DALL-E 3 и других моделей
OPENAI_API_KEY=
# Google Vertex AI переменные — требует настройки через Google Cloud Console
VERTEX_PROJECT_ID=your-gcp-project-id
VERTEX_LOCATION=us-central1
# Путь к service account JSON файлу (НЕ коммитьте реальные ключи в репозиторий!)
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
# Рекомендация: используйте ADC (Application Default Credentials) в production
MEDIA_PROVIDER_DEFAULT=dall-e-3
MEDIA_VIDEO_PROVIDER_DEFAULT=veo-3
ALLOW_MEDIA_FALLBACK=true

# === SMOKE & DEBUG FLAGS ===
RBAC_SMOKE_ADMIN=0
GOOGLE_AUTH_SMOKE_BYPASS=0

# === DEV BASELINE 5003 ===
# Утверждённая DEV политика портов (2025-11-10):
# - API Backend: 5003 (основной), 5001 (legacy) 
# - Frontend Primary: 3000, Frontend Backup: 3001
# - Старт: БД → API → Frontend
# Конфигурация: PORT=5003 (сервер), NEXT_PUBLIC_API_URL=http://localhost:5003 (фронтенд)
# Документация: README.md, RUNBOOK.md

# === ADDENDUM 2025-11-10 - Frontend API & CORS Configuration ===
# APPEND-ONLY: Существующие секции НЕ РЕДАКТИРУЮТСЯ
# Дата: 2025-11-10 01:59:28 UTC
# Автор: Kilo Code (code mode)

# === CORS ORIGIN (UPDATED) ===
# Добавлен порт 3001 и обновлен для стандартизированного API порта 5003
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:5003

# === FRONTEND API BASE (STANDARDIZED) ===
# Стандартизированная переменная для подключения фронтенда к API
NEXT_PUBLIC_API_BASE=http://localhost:5003

# === NOTES ===
# - PORT=5003 уже настроен в базовой секции (сохранен без изменений)
# - CORS_ORIGIN обновлен для поддержки всех фронтенд портов (3000, 3001) и API (5003)
# - NEXT_PUBLIC_API_BASE - новая стандартизированная переменная для фронтенда
# - Существующие Google OAuth redirect URI (5003) сохранен без изменений
# - DEV BASELINE 5003 секция сохранена полностью без изменений