# ── Version control ───────────────────────────────────────────────────────────
.git
.gitignore
.gitattributes

# ── Dependencies ──────────────────────────────────────────────────────────────
node_modules
**/node_modules

# ── Build artifacts ───────────────────────────────────────────────────────────
dist
build
.next
out

# ── Environment files (never bake secrets into images) ────────────────────────
.env
.env.*
!.env.example
!.env.prod.example

# ── Docker & compose files (not needed inside the image) ─────────────────────
Dockerfile
Dockerfile.*
docker-compose*.yml
.dockerignore

# ── Build automation ──────────────────────────────────────────────────────────
Taskfile.yml
Makefile

# ── CI/CD ─────────────────────────────────────────────────────────────────────
.github
.gitlab-ci.yml

# ── IDE & OS ─────────────────────────────────────────────────────────────────
.vscode
.idea
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.history

# ── Logs & temporary files ───────────────────────────────────────────────────
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
tmp
uploads

# ── Testing & coverage ────────────────────────────────────────────────────────
tests
coverage
.nyc_output
playwright-report
test-results

# ── Docs ─────────────────────────────────────────────────────────────────────
*.md
!README.md

# ── Misc ─────────────────────────────────────────────────────────────────────
.local
.husky
checkpoints
reports
