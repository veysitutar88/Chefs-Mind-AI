{
  "version": "2.1.6-unified-JSON",
  "project": "Chef's Mind AI",
  "mission": "Управлять архитектурой, логикой, UI, медиа и знаниями системы через многоагентный оркестратор.",
  "language": "ru",
  "core_principles": {
    "1": "Context → Action → Result",
    "2": "Сначала загружать CHECKPOINT → SESSION → MASTER_CONTEXT",
    "3": "Никаких фантазий. Только проверенные данные.",
    "4": "Структурированные короткие ответы.",
    "5": "Всегда сохранять состояние.",
    "6": "Выполнять правила v2.1.6.",
    "7": "Большие задачи разбивать на микропромпты."
  },
  "ui": {
    "theme": {
      "primary_bg": "#0B0F2A",
      "secondary_bg": "#11183D",
      "accent_glow": "#4BC9FF",
      "text": "#E5F4FF",
      "corner_radius": "20-24px"
    },
    "layout": {
      "left_sidebar": {
        "type": "card-buttons",
        "cards": [
          {
            "agent": "SousChef AI",
            "icon": "chef-hat",
            "subtitle": "Assists with recipes, plating, prep sheets"
          },
          {
            "agent": "GastroCount AI",
            "icon": "calculator",
            "subtitle": "Financial assistant: costs, analysis, reports"
          },
          {
            "agent": "GastroMind AI",
            "icon": "compass",
            "subtitle": "Knowledge, trends, insights"
          },
          {
            "agent": "FoodFrame AI",
            "icon": "image",
            "subtitle": "Food visuals, photos, videos"
          }
        ]
      },
      "center": {
        "type": "chat-window",
        "supports": [
          "markdown",
          "attachments",
          "multi-agent prompts"
        ]
      },
      "right_sidebar": {
        "type": "mini-panel",
        "modules": [
          "library",
          "assets",
          "calendar-preview",
          "recent-files"
        ]
      }
    }
  },
  "agents": {
    "orchestrator": {
      "model": "GPT-5",
      "role": "Главный управляющий",
      "duties": [
        "Распределение задач",
        "Контроль качества",
        "Анти-галлюцинации",
        "Сбор и структурирование контекста",
        "Вызов KiloCode и Gemini 3 Pro"
      ]
    },
    "specialized": {
      "SousChef AI": {
        "focus": [
          "рецепты",
          "кулинарная технология",
          "food-tech",
          "mise-en-place",
          "plating"
        ]
      },
      "GastroCount AI": {
        "focus": [
          "финансы",
          "себестоимость",
          "закупки",
          "аналитика",
          "отчёты"
        ]
      },
      "GastroMind AI": {
        "focus": [
          "research",
          "trend analysis",
          "web data",
          "cross-check"
        ]
      },
      "FoodFrame AI": {
        "focus": [
          "image generation",
          "video generation",
          "prompt enhancement",
          "branding",
          "food photography style"
        ]
      }
    }
  },
  "external_engines": {
    "kilocode": {
      "mode": "project",
      "rules": [
        "no hallucinations",
        "manifest-lock",
        "safe patches only",
        "analyze-before-edit"
      ]
    },
    "gemini": {
      "model": "Gemini 3 Pro",
      "codename": "Antigravity",
      "usage": [
        "heavy analysis",
        "creative generation",
        "large reasoning tasks"
      ]
    }
  },
  "workflow": {
    "load_order": [
      "MASTER_CONTEXT_v2.1.6",
      "CHECKPOINT.json",
      "SESSION.md",
      "AGENT_ROUTING_DESIGN.md",
      "MASTER_STRATEGY_v2.2"
    ],
    "task_flow": [
      "interpret",
      "route_to_agent",
      "agent_output",
      "qa_gate",
      "final_answer",
      "update_session",
      "update_checkpoint"
    ]
  },
  "persistence": {
    "checkpoint": {
      "file": "CHECKPOINT.json",
      "fields": ["active_tasks", "completed", "ui_version", "agent_state"]
    },
    "session": {
      "file": "SESSION.md",
      "stores": [
        "последние решения",
        "новые указания",
        "состояние агентов"
      ]
    }
  }
}
