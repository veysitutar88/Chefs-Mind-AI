# === PRODUCTION TEST ENVIRONMENT ===
# Скопируйте и переименуйте в .env для production тестирования

# === CORE ===
PORT=5003
NODE_ENV=production

# === DATABASE & CACHE ===
DATABASE_URL=postgres://postgres:password@db:5432/chefsmind_prod
DATABASE_READONLY_URL=postgres://postgres:password@db:5432/chefsmind_prod_ro
REDIS_URL=redis://redis:6379/0

# === SECURITY & AUTH ===
SAFE_MODE=on
CONFIRM_CODE=chefsmind-test-2024
SESSION_SECRET=chefsmind-production-secret-key-for-sessions-testing-2024
COOKIE_DOMAIN=localhost

# === CORS ===
CORS_ORIGIN=http://localhost:3000,http://localhost:5001

# === GOOGLE OAUTH & SERVICES ===
# ВАЖНО: Замените эти значения реальными из Google Cloud Console
GOOGLE_CLIENT_ID=test-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=test-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5001/auth/google/callback
GOOGLE_SCOPES=email profile https://www.googleapis.com/auth/calendar https://www.googleapis.com/auth/drive https://www.googleapis.com/auth/spreadsheets
GOOGLE_API_KEY=test-google-api-key
# Google OAuth — альтернативные имена переменных (для совместимости)
GOOGLE_OAUTH_CLIENT_ID=test-google-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=test-google-client-secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5001/auth/google/callback

# === MEDIA PROVIDERS ===
OPENAI_API_KEY=test-openai-api-key
MEDIA_PROVIDER_DEFAULT=dall-e-3
ALLOW_MEDIA_FALLBACK=true

# === SMOKE & DEBUG FLAGS ===
RBAC_SMOKE_ADMIN=0
GOOGLE_AUTH_SMOKE_BYPASS=1

# === ADDENDUM 2025-11-10 - CORS & Frontend API Configuration ===
# APPEND-ONLY: Существующие секции НЕ РЕДАКТИРУЮТСЯ
# Дата: 2025-11-10 01:58:59 UTC
# Автор: Kilo Code (code mode)

# === CORS ORIGN UPDATE ===
# Добавлен порт 3001 и обновлен для стандартизированного API порта 5003
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:5003

# === FRONTEND API BASE (STANDARDIZED) ===
# Стандартизированная переменная для подключения фронтенда к API
NEXT_PUBLIC_API_BASE=http://localhost:5003

# === NOTES ===
# - PORT=5003 уже настроен в базовой секции (сохранен без изменений)
# - CORS_ORIGIN обновлен для поддержки всех фронтенд портов (3000, 3001) и API (5003)
# - NEXT_PUBLIC_API_BASE - новая стандартизированная переменная
# - Существующие Google OAuth redirect URI (5001) сохранен для совместимости