{
  "name": "rest-express",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently \"npm run dev:back\" \"npm run dev:front\"",
    "dev:back": "npm run dev:server",
    "dev:front": "npm run dev:client",
    "dev:server": "cross-env NODE_ENV=development PORT=5003 tsx watch server/index.ts",
    "dev:client": "cd frontend-enhanced && npm run dev",
    "build": "npm run build:server",
    "build:server": "cross-env NODE_OPTIONS=--max_old_space_size=4096 tsc -p tsconfig.json",
    "postbuild": "node scripts/fix-esm-extensions.mjs dist",
    "build:client": "cd frontend-enhanced && npm run build",
    "start": "cross-env NODE_ENV=production node dist/server/index.js",
    "check": "tsc",
    "drizzle:generate": "drizzle-kit generate",
    "drizzle:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate:pg",
    "db:migrate": "tsx ./drizzle/migrate.ts",
    "db:seed": "node -r tsx ./drizzle/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --config=playwright.config.ts",
    "test:integration": "vitest tests/integration/*.test.ts",
    "test:media": "vitest tests/it/media.spec.ts",
    "test:mcp": "vitest tests/mcp/prompt-enhancer.spec.ts",
    "smoke:media": "sh scripts/smoke-media.sh",
    "smoke:media:auth": "sh scripts/smoke-media-auth.sh",
    "lint": "npx eslint --config eslint.config.mjs .",
    "lint:fix": "npx eslint --config eslint.config.mjs . --fix",
    "ci:lint-tsc": "npm run lint && npm run check",
    "ui:screenshots": "node scripts/capture-ui-screenshots.mjs",
    "format": "prettier --write .",
    "prepare": "husky",
    "smoke:ci:local": "bash scripts/smoke-local.sh"
  },
